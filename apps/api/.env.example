# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
APP_URL=http://localhost:5173
TRUST_PROXY=false

# Database (use a dedicated least-privilege database user in production)
# In production, provide your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/scambreak?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/scambreak

# Secrets: use independent, high-entropy values of at least 32 characters.
# Generate locally, for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SIGNING_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters

# Cookie / CORS settings.
# In production with GitHub Pages frontend, set:
# CORS_ORIGINS=https://<your-username>.github.io
# COOKIE_SAMESITE=none
AUTH_JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=lax

# Abuse controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
MAX_REQUEST_BODY_KB=256
MAX_UPLOAD_BYTES=10485760

# Private evidence is never served statically. Use a dedicated encrypted object
# store in production; this filesystem path is suitable only for local development.
PRIVATE_STORAGE_PATH=./data/private-evidence
ENTITY_HASH_PEPPER=replace-with-a-distinct-long-random-secret-at-least-32-characters
ANALYSIS_RETENTION_DAYS=90
UPLOAD_RETENTION_HOURS=24
# Private image bytes are purged before their metadata. Analysis auto-deletion
# is deliberately opt-in so deployment owners can align it with their policy.
RETENTION_ENFORCEMENT_ENABLED=false
PRIVACY_MAINTENANCE_SWEEP_HOURS=1

# Optional provider configuration. Leaving values blank disables the provider; it does not fabricate results.
AI_PROVIDER=none
AI_API_KEY=
URL_REPUTATION_PROVIDER=none
URL_REPUTATION_API_KEY=
STORAGE_PROVIDER=local
STORAGE_BUCKET=
EMAIL_PROVIDER=none
EMAIL_API_KEY=

# Feature flags
FEATURE_COMMUNITY_REPORTS=false
FEATURE_EXTERNAL_INTELLIGENCE=false
