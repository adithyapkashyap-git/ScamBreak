# ScamBreak Web Frontend Environment Example
# Copy to apps/web/.env or .env.local for development

# Development: http://localhost:4000
# Production: https://<your-backend-api-domain>.com (e.g. Render / Railway / Fly)
VITE_API_BASE_URL=http://localhost:4000

# Base URL path for assets and client-side routing
# For GitHub Pages user/repo deployment: /ScamBreak/
# For custom domain or root deployment: /
VITE_BASE_PATH=/

# Local rule-based demo fallback (set to 'true' to allow offline simulation when API is unreachable)
VITE_ENABLE_LOCAL_DEMO=false
